# Copy with `pnpm env:local`; it creates an ignored .env with a random local DB password.
# Never put real credentials here: this template is tracked by Git.

# Local PostgreSQL; keep bound to 127.0.0.1 in compose.yaml.
POSTGRES_DB=radio88_local
POSTGRES_USER=radio88_local
POSTGRES_PASSWORD=
POSTGRES_PORT=5434
DATABASE_URL=postgresql://radio88_local:LOCAL_PASSWORD@127.0.0.1:5434/radio88_local

# Separate ports for the API process and the Vite development server.
NODE_ENV=development
API_PORT=8080
VITE_PORT=20439
LOCAL_API_PROXY_TARGET=
BASE_PATH=/
LOG_LEVEL=info

# Clerk development instance. Only the publishable key may be exposed to Vite.
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
STORE_ADMIN_EMAIL=

# Resend API. Delivery is off in local development until explicitly enabled.
EMAIL_PROVIDER=resend
EMAIL_DELIVERY_ENABLED=false
RESEND_API_KEY=
STORE_EMAIL_FROM=

# Public catalog image storage. Use an R2 token limited to this development bucket.
R2_S3_ENDPOINT=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# SuperFrete sandbox only.
SUPERFRETE_BASE_URL=https://sandbox.superfrete.com
SUPERFRETE_TOKEN=
SUPERFRETE_CONTACT_EMAIL=
STORE_ORIGIN_CEP=

# Fiscal provider defaults to manual for local development.
FISCAL_MODE=manual
